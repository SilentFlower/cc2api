+    pub fn http1_header_casing<I, S>(mut self, names: I) -> RequestBuilder
+    where
+        I: IntoIterator<Item = S>,
+        S: AsRef<str>,
+    {
+        match HeaderCaseMap::from_names(names) {
+            Ok(map) => {
+                if let Ok(ref mut request) = self.request {
+                    request.header_case_map = Some(map);
+                }
+            }
+            Err(error) => self.request = Err(crate::error::builder(error)),
+        }
+        self
+    }
